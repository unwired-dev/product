{
  "name": "@private-email/product",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "fallow": "fallow --format json",
    "format": "turbo run format",
    "format:fix": "turbo run format:fix",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "mail:test": "pnpm --filter @private-email/mail-test-harness mail:test",
    "prepare": "effect-tsgo patch --oxlint",
    "test": "turbo run test",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@effect/tsgo": "catalog:",
    "@rajzik/oxfmt-config": "catalog:",
    "@rajzik/oxlint-config": "catalog:",
    "fallow": "^3.30.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.5.2"
  },
  "packageManager": "pnpm@11.5.2"
}
