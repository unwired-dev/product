# Product workspace environment variables
#
# Convex backend: copy to packages/convex/.env.local
# Apple app: set CONVEX_URL in apps/unwired-mail/.env.local or your Xcode scheme (see README.md)

# Deployment selected by `pnpm dev` / `convex dev`.
# Populated automatically after you log in to Convex for the first time.
CONVEX_DEPLOYMENT=

# Public Convex deployment URL shown by `convex dev`.
# Use the same value as CONVEX_URL in the unwired-mail Xcode scheme.
CONVEX_URL=
