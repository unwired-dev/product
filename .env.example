# Product workspace environment variables
#
# Convex backend: copy to .env.local at the repository root
# Apple app: debug builds also read GMAIL_OAUTH_CLIENT_ID, GMAIL_PUBSUB_TOPIC, and
# MICROSOFT_GRAPH_CLIENT_ID from the repository root. App-specific values can override them
# in apps/unwired-mail/.env.local.

# Deployment selected by `pnpm dev:convex` / `convex dev`.
# Populated automatically after you log in to Convex for the first time.
CONVEX_DEPLOYMENT=

# Public Convex deployment URL shown by `convex dev`.
# Use the same value as CONVEX_URL in the unwired-mail Xcode scheme.
CONVEX_URL=

# Apple bundle identifier validated in Sign in with Apple identity tokens.
# Must match the unwired-mail app bundle ID. No default: if both APPLE_BUNDLE_ID
# and APPLE_PRODUCT_CLIENT_IDS are unset, no Apple token is accepted.
APPLE_BUNDLE_ID=dev.unwired.mail

# Backend-only Sign in with Apple key used to exchange and revoke authorization on deletion.
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY=
APPLE_TEAM_ID=

# Google iOS OAuth client ID used for Gmail sign-in and token validation.
# Create it for the unwired-mail app bundle ID in Google Cloud Console.
GMAIL_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Fully qualified Pub/Sub topic used by the Apple app's device-held Gmail watch request.
GMAIL_PUBSUB_TOPIC=projects/your-google-cloud-project/topics/gmail-push

# Public-client application ID used for Microsoft Graph sign-in.
MICROSOFT_GRAPH_CLIENT_ID=your-microsoft-application-client-id

# Shared secret included in the Pub/Sub push subscription endpoint query string.
GMAIL_PUSH_VERIFICATION_TOKEN=

# Backend-only HMAC key for opaque Gmail push-routing digests. Generate a high-entropy value.
GMAIL_ROUTING_KEY=
GMAIL_ROUTING_KEY_VERSION=1
GMAIL_IDENTITY_BINDING_KEY=

# During key rotation, retain the previous key and version until active routes renew.
GMAIL_ROUTING_PREVIOUS_KEY=
GMAIL_ROUTING_PREVIOUS_KEY_VERSION=

# APNs token-authentication values used only by the Convex deployment.
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_TEAM_ID=
APNS_TOPIC=dev.unwired.mail

# Replacement hosts: public, native iOS OAuth client ID for their shared bundle ID.
# Set when generating each app. Never use a web client secret.
UNWIRED_GOOGLE_CLIENT_ID=
UNWIRED_CONVEX_URL=

# Convex deployment: comma-separated native Google OAuth audiences accepted for Product Sign-In.
# Include the hosts' native client; an empty value retains the existing Apple configuration.
GOOGLE_PRODUCT_CLIENT_IDS=

# Convex deployment: further comma-separated bundle IDs accepted as Sign in with Apple
# audiences, in addition to APPLE_BUNDLE_ID. Both replacement hosts use APPLE_BUNDLE_ID.
APPLE_PRODUCT_CLIENT_IDS=
