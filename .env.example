# Product workspace environment variables
#
# Convex backend: copy to packages/convex/.env.local
# Apple app: set CONVEX_URL in apps/unwired-mail/.env.local or your Xcode scheme (see README.md)

# Deployment selected by `pnpm dev` / `convex dev`.
# Populated automatically after you log in to Convex for the first time.
CONVEX_DEPLOYMENT=

# Public Convex deployment URL shown by `convex dev`.
# Use the same value as CONVEX_URL in the unwired-mail Xcode scheme.
CONVEX_URL=

# Apple bundle identifier validated in Sign in with Apple identity tokens.
# Must match the unwired-mail app bundle ID (default: dev.unwired.mail).
APPLE_BUNDLE_ID=dev.unwired.mail

# Fully qualified Pub/Sub topic used by the Apple app's device-held Gmail watch request.
GMAIL_PUBSUB_TOPIC=projects/your-google-cloud-project/topics/gmail-push

# Shared secret included in the Pub/Sub push subscription endpoint query string.
GMAIL_PUSH_VERIFICATION_TOKEN=

# APNs token-authentication values used only by the Convex deployment.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=dev.unwired.mail
