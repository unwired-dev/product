{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "APPLE_BUNDLE_ID",
    "APPLE_PRODUCT_CLIENT_IDS",
    "APNS_KEY_ID",
    "APNS_PRIVATE_KEY",
    "APNS_TEAM_ID",
    "APNS_TOPIC",
    "GMAIL_OAUTH_CLIENT_ID",
    "GMAIL_PUSH_VERIFICATION_TOKEN",
    "GMAIL_ROUTING_KEY",
    "GMAIL_ROUTING_KEY_VERSION",
    "GMAIL_IDENTITY_BINDING_KEY",
    "GMAIL_ROUTING_PREVIOUS_KEY",
    "GMAIL_ROUTING_PREVIOUS_KEY_VERSION",
    "GOOGLE_PRODUCT_CLIENT_IDS",
    "UNWIRED_GOOGLE_CLIENT_ID",
    "UNWIRED_CONVEX_URL"
  ],
  "tasks": {
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#format": {},
    "//#format:fix": {
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interactive": true,
      "passThroughEnv": ["*"]
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["UNWIRED_MOCK_SCENARIO"],
      "cache": false
    },
    "verify:bundle": {
      "dependsOn": ["build"],
      "env": ["UNWIRED_MOCK_SCENARIO"],
      "cache": false
    },
    "ios": {
      "cache": false,
      "persistent": true,
      "interactive": true,
      "passThroughEnv": ["*"]
    },
    "macos": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "native:generate": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "native:pods": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "native:build": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "test:native": {
      "cache": false,
      "passThroughEnv": ["*"]
    }
  },
  "globalDependencies": [
    "oxlint.config.ts",
    "oxfmt.config.ts",
    "tsconfig.effect.json",
    "scripts/oxlint-effect-imports.mjs",
    "scripts/oxlint-effect-boundaries.mjs",
    "scripts/oxlint-effect-policy.ts",
    "scripts/mock-mail-build.cjs",
    "scripts/mock-mail-scenarios.json"
  ]
}
