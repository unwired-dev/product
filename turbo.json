{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "APPLE_BUNDLE_ID",
    "APNS_KEY_ID",
    "APNS_PRIVATE_KEY",
    "APNS_TEAM_ID",
    "APNS_TOPIC",
    "GMAIL_OAUTH_CLIENT_ID",
    "GMAIL_PUSH_VERIFICATION_TOKEN",
    "GMAIL_ROUTING_KEY"
  ],
  "tasks": {
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "format:fix": {
      "dependsOn": ["^format:fix"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
