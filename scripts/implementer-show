#!/bin/sh
# git show for implementers, or git diff with --diff first, to read reviewer fixes. Every path in
# scripts/reviewer-only-paths is excluded, whatever pathspecs the caller adds after `--`; the
# reviewer-only paths the same revisions change print afterwards by name only.
# Usage: scripts/implementer-show [--diff] [options] [<revision>...] [-- <pathspec>...]
set -eu

reject() {
  printf 'implementer-show: %s\n' "$1" >&2
  exit 2
}

command=show
if [ "${1-}" = --diff ]; then
  command=diff
  shift
fi

set -f
paths=$(cat "$(dirname "$0")/reviewer-only-paths")

separated=false
value=
remaining=$#
while [ "$remaining" -gt 0 ]; do
  argument=$1
  shift
  remaining=$((remaining - 1))
  if [ "$separated" = true ]; then
    set -- "$@" "$argument"
    continue
  fi
  # Attach operands so Git's earlier log-option pass cannot reinterpret them.
  if [ -n "$value" ]; then
    set -- "$@" "$value$argument"
    value=
    continue
  fi
  case "$argument" in
    --) separated=true ;;
    --grep|--grep-reflog|--author|--committer|--since|--since-as-filter|--until|--after|--before|--date|--encoding|--max-count|--skip|--max-age|--min-age|\
    --decorate-refs|--decorate-refs-exclude|\
    --stat-width|--stat-name-width|--stat-graph-width|--stat-count|--ws-error-highlight|--src-prefix|--dst-prefix|--line-prefix|--inter-hunk-context|\
    --output-indicator-new|--output-indicator-old|--output-indicator-context|--ignore-matching-lines|--diff-algorithm|--anchored|--word-diff-regex|--color-moved-ws|\
    --rotate-to|--skip-to|--find-object|--diff-filter|--max-depth)
      value="$argument="
      continue ;;
    --output|--output=*) reject '--output writes outside stdout and drops the reviewer-only names.' ;;
    --end-of-options) reject 'use -- before pathspecs; --end-of-options disables the name-only output controls.' ;;
    --default|--stdin|--all|--branches|--branches=*|--tags|--tags=*|--remotes|--remotes=*|--glob|--glob=*|--reflog|--alternate-refs|--indexed-objects|--bisect)
      reject 'indirect object inputs can print trees and blobs outside the pathspecs; pass explicit commit revisions.' ;;
    --full-diff|--no-index)
      reject '--full-diff and --no-index print files outside the pathspecs.' ;;
    --ext-diff|--textconv) reject 'external diff and textconv helpers can read excluded files.' ;;
    --name-status|--check) reject 'use --name-only or --stat; --name-status and --check cannot list reviewer-only names.' ;;
    --*) ;;
    -?*)
      options=${argument#-}
      while [ -n "$options" ]; do
        option=${options%"${options#?}"}
        options=${options#?}
        case "$option" in
          z) reject 'NUL-delimited output cannot preserve the reviewer-only names inventory.' ;;
          S|G|O|I|l|n)
            [ -n "$options" ] || value=$argument
            break ;;
          U|X|B|M|C) break ;; # Optional values must be attached, not skipped.
        esac
      done ;;
    -) ;;
    *:*) reject 'tree and blob selectors bypass root exclusions; use revisions and pathspecs after --.' ;;
    *)
      # Refs cannot contain `..`, so this splits ranges into their ends.
      for end in $(printf '%s\n' "${argument#^}" | sed 's/\.\.\.*/ /g'); do
        type=$(git cat-file -t "$end^{}" 2>/dev/null) || type=
        case "$type" in
          tree|blob) reject 'tree and blob selectors bypass root exclusions; use revisions and pathspecs after --.' ;;
        esac
      done ;;
  esac
  [ -z "$value" ] || continue
  set -- "$@" "$argument"
done
[ -z "$value" ] || reject 'missing option operand.'

# The same revisions and options limited to reviewer-only paths, with the caller's pathspecs dropped.
names=$(
  remaining=$#
  while [ "$remaining" -gt 0 ]; do
    argument=$1
    shift
    remaining=$((remaining - 1))
    if [ "$argument" = -- ]; then
      shift "$remaining"
      break
    fi
    case "$argument" in
      (--log-size|--graph|--no-graph|--show-linear-break|--show-linear-break=*) continue ;;
      (-*) ;;
      (*)
        # show prints annotated tags outside --format, so peel them for this pass only.
        type=$(git cat-file -t "$argument" 2>/dev/null) || type=
        [ "$type" != tag ] || argument="$argument^{}" ;;
    esac
    set -- "$@" "$argument"
  done
  set -- "$@" --no-ext-diff --no-textconv --no-relative --no-exit-code --no-show-signature --no-notes --color=never --line-prefix= --format= --patch --name-only --
  for path in $paths; do
    set -- "$@" ":(top)$path"
  done
  git --no-pager "$command" "$@"
)

if [ "$separated" = false ]; then
  set -- "$@" --
fi
for path in $paths; do
  set -- "$@" ":(top,exclude)$path"
done
status=0
git --no-pager "$command" --no-ext-diff --no-textconv "$@" || status=$?
if [ -n "$names" ]; then
  printf '%s\n' 'Reviewer-only paths (names only; do not open):'
  printf '%s\n' "$names" | awk 'NF && !seen[$0]++'
fi
exit "$status"
