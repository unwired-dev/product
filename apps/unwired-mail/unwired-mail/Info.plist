<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>GmailOAuthClientId</key>
	<string>$(GMAIL_OAUTH_CLIENT_ID)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GMAIL_OAUTH_CALLBACK_SCHEME)</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(MICROSOFT_GRAPH_CALLBACK_SCHEME)</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(EWS_OAUTH_CALLBACK_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>EWSOAuthAuthorizationEndpoint</key>
