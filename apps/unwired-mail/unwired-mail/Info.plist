	<string>$(GMAIL_PUBSUB_TOPIC)</string>
	<key>MicrosoftGraphCallbackScheme</key>
	<string>$(MICROSOFT_GRAPH_CALLBACK_SCHEME)</string>
	<key>MicrosoftGraphClientId</key>
	<string>$(MICROSOFT_GRAPH_CLIENT_ID)</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Review invitations and find, add, update, or remove matching calendar events.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Review invitations and find, add, update, or remove matching calendar events.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>dev.unwired.mail.refresh</string>
	</array>
