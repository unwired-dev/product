{
  "extends": "../../tsconfig.effect.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["node", "jest"],
    "allowImportingTsExtensions": true,
    "paths": {
      "react-native": ["./node_modules/react-native-macos"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.tsx", "scripts/**/*.ts"]
}
