+// AppKit's press action (VoiceOver's VO-Space) sends the click that Pressability handles as an
+// accessibility click, so it runs the same onPress as a mouse click.
+- (BOOL)canPerformAccessibilityPress
+{
+  // Like a disabled NSButton, a disabled control keeps the action and ignores it.
+  return _eventEmitter && _props->hostPlatformEvents[HostPlatformViewEvents::Offset::Click];
+}
+
+- (BOOL)accessibilityPerformPress
+{
+  if (![self canPerformAccessibilityPress] || !self.isAccessibilityEnabled) {
+    return NO;
+  }
+  _eventEmitter->onAccessibilityPress();
+  return YES;
+}
+
+- (BOOL)isAccessibilitySelectorAllowed:(SEL)selector
+{
+  if (selector == @selector(accessibilityPerformPress)) {
+    return [self canPerformAccessibilityPress];
+  }
+  return [super isAccessibilitySelectorAllowed:selector];
+}
