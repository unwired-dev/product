+// A click without pointerType, which Pressability's onClick treats as an accessibility click.
+void HostPlatformViewEventEmitter::onAccessibilityPress() const {
+  dispatchEvent("click", [](jsi::Runtime& runtime) {
+    auto payload = jsi::Object(runtime);
+    payload.setProperty(runtime, "button", 0);
+    return payload;
+  });
+}
