   private func onViewOriginChange() {
     viewFrameOriginChangeObserver?.splitNavCtrlViewDidChangeFrameOrigin(self)
   }
+
+  // Unwired Mail: while the split view shows its columns side by side, each column draws its own
+  // header and controls, so the columns start beneath the status bar. A collapsed split view
+  // keeps its navigation bars, whose Back returns between the stacked columns.
+  var columnsShowBars: Bool { splitViewController?.isCollapsed ?? true }
+
+  override public func viewWillLayoutSubviews() {
+    super.viewWillLayoutSubviews()
+    if isNavigationBarHidden == columnsShowBars {
+      setNavigationBarHidden(!columnsShowBars, animated: false)
+    }
+  }
