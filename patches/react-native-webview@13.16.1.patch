+
+// Product patch: measures the laid-out document in the app's isolated client world, so page
+// JavaScript stays disabled and the page cannot observe or alter the measurement.
+- (void)reportContentSize
+{
+  if (!_onContentSizeChange) {
+    return;
+  }
+  __weak RNCWebViewImpl *weakSelf = self;
+  [_webView callAsyncJavaScript:@"const root = document.documentElement; return [root.scrollWidth, root.scrollHeight];"
+                      arguments:nil
+                        inFrame:nil
+                 inContentWorld:WKContentWorld.defaultClientWorld
+              completionHandler:^(id result, NSError *error) {
+    RNCWebViewImpl *strongSelf = weakSelf;
+    if (strongSelf == nil || strongSelf->_webView == nil || strongSelf->_onContentSizeChange == nil) {
+      return;
+    }
+    NSArray *size = [result isKindOfClass:[NSArray class]] ? result : nil;
+    BOOL valid = error == nil && size.count == 2 &&
+      [size[0] isKindOfClass:[NSNumber class]] && [size[1] isKindOfClass:[NSNumber class]] &&
+      isfinite([size[0] doubleValue]) && isfinite([size[1] doubleValue]) &&
+      [size[0] doubleValue] > 0 && [size[1] doubleValue] > 0;
+    if (!valid) {
+      // A failed measurement must reveal the reader's terminal plain-text fallback.
+      // No foreign error, document title, URL or message content crosses this event.
+      if (strongSelf->_onLoadingError) {
+        strongSelf->_onLoadingError(@{
+          @"url": @"about:blank", @"title": @"", @"loading": @NO,
+          @"canGoBack": @NO, @"canGoForward": @NO, @"lockIdentifier": @0,
+          @"domain": @"UnwiredMessageRendering", @"code": @1,
+          @"description": @"Message layout could not be measured."
+        });
+      }
+      return;
+    }
+    strongSelf->_onContentSizeChange(@{
+      @"contentSize": @{@"width": size[0], @"height": size[1]}
+    });
+  }];
 }
 
