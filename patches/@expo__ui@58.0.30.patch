+
+#if os(iOS)
+// Unwired Mail draws popovers without an arrow (#2255). SwiftUI has no option for it, so the
+// presenting UIPopoverPresentationController drops the arrow. An arrowless popover is centred on its
+// source rect, so the rect moves above or below the control, and for a leading popover spans its
+// width from the control's leading edge.
+private struct ArrowlessPopover: UIViewControllerRepresentable {
+  let leading: Bool
+
+  func makeUIViewController(context: Context) -> ArrowlessPopoverController {
+    ArrowlessPopoverController()
+  }
+
+  func updateUIViewController(_ controller: ArrowlessPopoverController, context: Context) {
+    controller.leading = leading
+  }
+}
+
+internal final class ArrowlessPopoverController: UIViewController {
+  // The gap between the control and the popover in the approved Filters frame.
+  private static let gap: CGFloat = 13
+  // The sidebar can show or hide while the popover is open, as when the iPad rotates. Nothing else
+  // lays the open popover out again then, so the new rect would wait for the next layout.
+  var leading = false {
+    didSet {
+      if leading != oldValue, let presented {
+        place(presented)
+        presented.popoverPresentationController?.containerView?.setNeedsLayout()
+      }
+    }
+  }
+  private weak var presented: UIViewController?
+  private var anchor: CGRect = .null
+  private var placed: CGRect = .null
+  private var arrow: UIPopoverArrowDirection = []
+  private var placing = false
+  private var observations: [NSKeyValueObservation] = []
+
+  override func viewWillAppear(_ animated: Bool) {
+    super.viewWillAppear(animated)
+    var presented: UIViewController = self
+    while let parent = presented.parent {
+      presented = parent
+    }
+    self.presented = presented
+    place(presented)
+    // A resized popover stays centred on its source rect, and SwiftUI moves the rect back onto the
+    // control when the control moves, so either change places it again.
+    observations = [
+      presented.observe(\.preferredContentSize) { [weak self] presented, _ in
+        self?.place(presented)
+      }
+    ]
+    if let popover = presented.popoverPresentationController {
+      observations.append(
+        popover.observe(\.sourceRect) { [weak self, weak presented] _, _ in
+          if let presented {
+            self?.place(presented)
+          }
+        })
+    }
+  }
+
+  private func place(_ presented: UIViewController) {
+    guard !placing, let popover = presented.popoverPresentationController,
+      let source = popover.sourceView,
+      let window = source.window
+    else {
+      return
+    }
+    // SwiftUI sets the anchor before the first placement and whenever the control moves.
+    if popover.sourceRect != placed {
+      anchor = popover.sourceRect
+    }
+    if popover.permittedArrowDirections != [] {
+      arrow = popover.permittedArrowDirections
+    }
+    // Below the control when the arrow edge is the top, above it when it is the bottom, and
+    // otherwise below it when it fits.
+    let height = presented.preferredContentSize.height
+    let room = window.bounds.maxY - window.safeAreaInsets.bottom - source.convert(anchor, to: window).maxY
+    let below = arrow == .up || (arrow != .down && room >= Self.gap + height)
+    let y = below ? anchor.maxY + Self.gap : anchor.minY - Self.gap - height
+    let width = leading ? presented.preferredContentSize.width : anchor.width
+    let x =
+      leading && source.effectiveUserInterfaceLayoutDirection == .rightToLeft
+      ? anchor.maxX - width : anchor.minX
+    placed = CGRect(x: x, y: y, width: width, height: height)
+    popover.permittedArrowDirections = []
+    // Setting the rect notifies the observer, and UIKit may keep a slightly different rect, so the
+    // kept rect is this placement.
+    placing = true
+    popover.sourceRect = placed
+    placed = popover.sourceRect
+    placing = false
+  }
+}
+#endif
