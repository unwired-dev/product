+#if os(iOS)
+// A `Host` inside the hosted content tracks its touches with SwiftUI's own recognizers, which a pan
+// outside it, such as the sheet's drag or a React Native scroll view, does not prevent: a short
+// sheet drag released at rest would still fire the SwiftUI `Button` it started on (#3077). Such a
+// pan cancels a `Pressable` as it begins; this cancels the nested `Host`'s recognizers at that
+// moment too. It never recognizes and prevents nothing.
+private final class NestedHostTouchCanceller: UIGestureRecognizer {
+  private var nested: [UIGestureRecognizer] = []
+  private var outside: [UIPanGestureRecognizer] = []
+
+  init() {
+    super.init(target: nil, action: nil)
+    cancelsTouchesInView = false
+    delaysTouchesEnded = false
+  }
+
+  override func touchesBegan(_ touches: Set<UITouch>, with event: UIEvent) {
+    super.touchesBegan(touches, with: event)
+    for touch in touches {
+      guard let host = outermostHost(above: touch.view) else {
+        continue
+      }
+      for recognizer in touch.gestureRecognizers ?? [] {
+        // A scroll view inside the `Host` scrolls as before.
+        if let view = recognizer.view, view.isDescendant(of: host), !(view is UIScrollView) {
+          nested.append(recognizer)
+        } else if let pan = recognizer as? UIPanGestureRecognizer, !outside.contains(pan) {
+          pan.addTarget(self, action: #selector(outsidePanChanged(_:)))
+          outside.append(pan)
+        }
+      }
+    }
+  }
+
+  override func touchesEnded(_ touches: Set<UITouch>, with event: UIEvent) {
+    super.touchesEnded(touches, with: event)
+    failOnceLifted(event)
+  }
+
+  override func touchesCancelled(_ touches: Set<UITouch>, with event: UIEvent) {
+    super.touchesCancelled(touches, with: event)
+    failOnceLifted(event)
+  }
+
+  override func reset() {
+    super.reset()
+    for pan in outside {
+      pan.removeTarget(self, action: #selector(outsidePanChanged(_:)))
+    }
+    outside = []
+    nested = []
+  }
+
+  override func canPrevent(_ preventedGestureRecognizer: UIGestureRecognizer) -> Bool {
+    false
+  }
+
+  override func canBePrevented(by preventingGestureRecognizer: UIGestureRecognizer) -> Bool {
+    false
+  }
+
+  @objc private func outsidePanChanged(_ pan: UIPanGestureRecognizer) {
+    guard pan.state == .began else {
+      return
+    }
+    // Disabling a recognizer cancels its touches; enabled again, it takes the next touch.
+    for recognizer in nested where recognizer.isEnabled {
+      recognizer.isEnabled = false
+      recognizer.isEnabled = true
+    }
+    nested = []
+  }
+
+  private func failOnceLifted(_ event: UIEvent) {
+    let down = event.touches(for: self)?.contains { $0.phase != .ended && $0.phase != .cancelled }
+    if down != true {
+      state = .failed
+    }
+  }
+
+  // The outermost `Host`, or other Expo view, between the touched view and the content root.
+  private func outermostHost(above touched: UIView?) -> UIView? {
+    var host: UIView?
+    var current = touched
+    while let candidate = current, candidate !== view {
+      if candidate is ExpoView {
+        host = candidate
+      }
+      current = candidate.superview
+    }
+    return host
+  }
+}
+#endif
