+// A copy of the wheel event keeping only its horizontal or vertical deltas.
+static NSEvent *RNCScrollAxis(NSEvent *event, BOOL horizontal)
+{
+  CGEventRef copy = CGEventCreateCopy(event.CGEvent);
+  if (copy == NULL) {
+    return event;
+  }
+  CGEventSetIntegerValueField(copy, horizontal ? kCGScrollWheelEventDeltaAxis1 : kCGScrollWheelEventDeltaAxis2, 0);
+  CGEventSetIntegerValueField(copy, horizontal ? kCGScrollWheelEventFixedPtDeltaAxis1 : kCGScrollWheelEventFixedPtDeltaAxis2, 0);
+  CGEventSetIntegerValueField(copy, horizontal ? kCGScrollWheelEventPointDeltaAxis1 : kCGScrollWheelEventPointDeltaAxis2, 0);
+  NSEvent *axis = [NSEvent eventWithCGEvent:copy];
+  CFRelease(copy);
+  return axis;
+}
