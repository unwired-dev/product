+  // Only app-sanitized image nodes change; the document, text, typography and scroll stay.
+  [_webView callAsyncJavaScript:@"globalThis.__unwiredRemoteRevision = revision;\nconst pending = [];\nfor (const element of document.querySelectorAll('[data-remote]')) {\n  const index = Number(element.dataset.remote), html = nodes[index];\n  if (typeof html !== 'string') continue;\n  const template = document.createElement('template');\n  template.innerHTML = html;\n  const next = template.content.firstElementChild;\n  if (template.content.childNodes.length !== 1 || !next || !['IMG', 'SPAN'].includes(next.tagName) || Number(next.dataset.remote) !== index) throw new Error('Invalid remote node');\n  if (next.tagName === 'IMG' && !next.getAttribute('src').startsWith('data:image/')) throw new Error('Nonlocal remote image');\n  if (element.outerHTML === next.outerHTML) continue;\n  element.replaceWith(next);\n  if (next.tagName === 'IMG') pending.push(next.decode().catch(() => undefined));\n}\nawait Promise.all(pending);\nif (globalThis.__unwiredRemoteRevision !== revision) return null;\nconst root = document.documentElement;\nreturn [root.scrollWidth, root.scrollHeight, Array.from(document.querySelectorAll('[data-remote]'), (element) => { const box = element.getBoundingClientRect(); return [Number(element.dataset.remote), box.top + window.scrollY, box.bottom + window.scrollY]; })];"
+                      arguments:@{@"nodes": nodes, @"revision": @(revision)}
+                        inFrame:nil
+                 inContentWorld:WKContentWorld.defaultClientWorld
+              completionHandler:^(id result, NSError *error) {
+    RNCWebViewImpl *strongSelf = weakSelf;
+    if (strongSelf == nil || strongSelf->_webView == nil || strongSelf->_onContentSizeChange == nil ||
+        revision != strongSelf->_messageRenderRevision || !strongSelf->_messageDocumentReady) {
+      return;
+    }
+    NSArray *size = [result isKindOfClass:[NSArray class]] ? result : nil;
+    BOOL valid = error == nil && size.count == 3 &&
+      [size[0] isKindOfClass:[NSNumber class]] && [size[1] isKindOfClass:[NSNumber class]] &&
+      isfinite([size[0] doubleValue]) && isfinite([size[1] doubleValue]) &&
+      [size[0] doubleValue] > 0 && [size[1] doubleValue] > 0;
+    if (!valid) {
