diff --git a/ios/gamma/split/RNSSplitHostController.mm b/ios/gamma/split/RNSSplitHostController.mm
index c7d2db759..14253b8f4 100644
--- a/ios/gamma/split/RNSSplitHostController.mm
+++ b/ios/gamma/split/RNSSplitHostController.mm
@@ -41,6 +41,9 @@ @implementation RNSSplitHostController {
    * avoiding crashes when certain columns are collapsed or hidden.
    */
   NSMutableSet<NSNumber *> *_visibleColumns;
+
+  // Unwired Mail: how many of the window's size transitions, such as rotations, are running.
+  NSInteger _sizeTransitions;
 }
 
 - (instancetype)initWithSplitHostComponentView:(RNSSplitHostComponentView *)splitHostComponentView
@@ -159,7 +162,38 @@ - (void)refreshSecondaryNavBar
 
   /** The assumption is that it should come in a single batch and it won't cause any delays in rendering the content. */
   [navigationController setNavigationBarHidden:YES animated:NO];
-  [navigationController setNavigationBarHidden:NO animated:NO];
+  // Unwired Mail: the bar returns only where the split view shows one (collapsed).
+  BOOL showsBar = [navigationController isKindOfClass:RNSSplitNavigationController.class]
+      ? ((RNSSplitNavigationController *)navigationController).columnsShowBars
+      : YES;
+  [navigationController setNavigationBarHidden:!showsBar animated:NO];
+}
+
+// Unwired Mail: a display mode asked for while the window rotates hides or shows a column without
+// moving the others, as when Portrait hides Mailboxes and leaves the list beside an empty space; so
+// the latest one asked for waits for the rotation to end.
+- (void)applyPreferredDisplayMode:(UISplitViewControllerDisplayMode)displayMode
+{
+  if (_sizeTransitions == 0) {
+    self.preferredDisplayMode = displayMode;
+  }
+}
+
+- (void)viewWillTransitionToSize:(CGSize)size
+       withTransitionCoordinator:(id<UIViewControllerTransitionCoordinator>)coordinator
+{
+  [super viewWillTransitionToSize:size withTransitionCoordinator:coordinator];
+  _sizeTransitions += 1;
+  __weak auto weakSelf = self;
+  [coordinator animateAlongsideTransition:nil
+                               completion:^(id<UIViewControllerTransitionCoordinatorContext> context) {
+                                 auto strongSelf = weakSelf;
+                                 if (strongSelf == nil) {
+                                   return;
+                                 }
+                                 strongSelf->_sizeTransitions -= 1;
+                                 [strongSelf applyPreferredDisplayMode:strongSelf->_splitHostComponentView.preferredDisplayMode];
+                               }];
 }
 
