diff --git a/ios/gamma/split/RNSSplitNavigationController.mm b/ios/gamma/split/RNSSplitNavigationController.mm
index 612a1c037..ac4bb20ec 100644
--- a/ios/gamma/split/RNSSplitNavigationController.mm
+++ b/ios/gamma/split/RNSSplitNavigationController.mm
@@ -5,6 +5,7 @@
 @implementation RNSSplitNavigationController {
   RNSSplitNavigationControllerFrameObserver *_frameObserver;
   id<RNSSplitNavigationControllerFrameOriginChangeDelegate> __weak _frameOriginChangeDelegate;
+  BOOL _barsHiddenForColumns;
 }
 
 - (instancetype)initWithRootViewController:(UIViewController *)rootViewController
@@ -41,6 +42,29 @@ - (void)viewDidLoad
   [_frameObserver registerForViewFrameChanges];
 }
 
+// Unwired Mail: while the split view shows its columns side by side, each column draws its own
+// header and controls, so the columns start beneath the status bar. Collapsing returns the bars,
+// whose Back moves between the stacked columns; after that each collapsed screen decides, as
+// iPhone's Mailboxes hides the bar above its own header.
+- (BOOL)columnsShowBars
+{
+  return self.splitViewController == nil || self.splitViewController.isCollapsed;
+}
+
+- (void)viewWillLayoutSubviews
+{
+  [super viewWillLayoutSubviews];
+  if (!self.columnsShowBars) {
+    _barsHiddenForColumns = YES;
+    if (!self.isNavigationBarHidden) {
+      [self setNavigationBarHidden:YES animated:NO];
+    }
+  } else if (_barsHiddenForColumns) {
+    _barsHiddenForColumns = NO;
+    [self setNavigationBarHidden:NO animated:NO];
+  }
+}
+
 - (void)dealloc
 {
   [_frameObserver unregisterForViewFrameChanges];
