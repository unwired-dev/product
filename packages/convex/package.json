{
  "name": "@private-email/convex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "convex dev",
    "format": "oxfmt --ignore-path ../../.gitignore --check .",
