{
  "name": "@private-email/convex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "convex dev",
    "format": "oxfmt --ignore-path ../../.gitignore --check .",
    "format:fix": "oxfmt --ignore-path ../../.gitignore --write .",
    "lint": "oxlint --type-aware --type-check --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint --type-aware --type-check --report-unused-disable-directives --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@private-email/contracts": "workspace:*",
    "convex": "catalog:"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@rajzik/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "convex-test": "^0.0.41",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "^7.1.12",
    "vitest": "catalog:"
  }
}
