{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    // Reviewers and the real-Git tests launch this CLI as a subprocess.
    "scripts/ocr-checkpoint.mjs",
    "scripts/oxlint-effect-imports.mjs",
    "scripts/oxlint-effect-boundaries.mjs",
    // Imported by the ignored Oxlint configuration files.
    "scripts/oxlint-effect-policy.ts",
    // The hosted native integration runner launches this protocol fixture.
    "native/private-inbox/integration/imap-server.mjs",
    "native/private-inbox/integration/smtp-server.mjs",
    // Metro selects these modules at build time, outside the static import graph.
    "scripts/mock-mail-build.cjs",
    "packages/mail-core/src/testing/open-read-relaunch.ts",
    "packages/mail-core/src/testing/mail-unavailable.ts",
    "packages/mail-core/src/testing/registration-mode.ts",
  ],
  "ignorePatterns": [
    "oxfmt.config.ts",
    "oxlint.config.ts",
    "**/convex/_generated/**",
    "apps/mobile/**",
    "apps/macos/**",
    "packages/mail-test-harness/**",
  ],
  "ignoreUnresolvedImports": ["**/_generated/**", "./_generated/dataModel.js"],
  "ignoreDependencies": [
    // Used by prepare and the ignored Oxlint configuration files.
    "@convex-dev/eslint-plugin",
    "@effect/tsgo",
    "@edge-runtime/vm",
    "@rajzik/oxfmt-config",
    "@rajzik/oxlint-config",
    "@rajzik/tsconfig",
    // Build tooling (scripts/mock-mail-build.cjs) runs from the development install.
    "effect",
  ],
}
